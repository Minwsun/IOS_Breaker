#!name=App2Smile Qidian (experimental)
#!desc=EXPERIMENTAL: Shadowrocket compatibility and current app behavior are unverified; upstream notes proxy must stay enabled while using Qidian on Quantumult X.
# Adapted from app2smile/rules at df6366a7024e0b3f0aa3510c5b791eea6f3cba89 (MIT).

[MITM]
hostname = %APPEND% magev6.if.qidian.com

[Script]
qidian-json = type=http-response,pattern=^https:\/\/magev6\.if\.qidian\.com\/argus\/api\/(v4\/client\/getsplashscreen|v2\/(deeplink\/geturl|dailyrecommend\/getdailyrecommend)|v1\/(client\/getconf$|bookshelf\/getHoverAdv|adv\/getadvlistbatch\?positions=iOS_tab)),requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/Minwsun/IOS_Breaker/refs/heads/codex/self-hosted-app-expansion/js/app2smile-qidian.js,script-update-interval=0