#!name=Photoroom - RevenueCat experimental
#!desc=Mapping discovery; fixture-tested only. Signed responses pass through. Never combine with another RevenueCat processor.
# Generated by scripts/build_premium_modules.py from config/revenuecat-apps.json.
# App selection is based on legacy User-Agent evidence; current app behavior is unverified.
[Script]
rc-photoroom-request = type=http-request,pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/v1\/(receipts|subscribers\/[^/?#]+)\/?(\?[^#]*)?$,script-path=https://raw.githubusercontent.com/Minwsun/IOS_Breaker/refs/heads/codex/self-hosted-app-expansion/js/revenuecat-compatible.js,timeout=10,argument=ua=PhotoRoom
rc-photoroom-response = type=http-response,pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/v1\/(receipts|subscribers\/[^/?#]+)\/?(\?[^#]*)?$,requires-body=true,max-size=1048576,script-path=https://raw.githubusercontent.com/Minwsun/IOS_Breaker/refs/heads/codex/self-hosted-app-expansion/js/revenuecat-compatible.js,timeout=10,argument=ua=PhotoRoom
[MITM]
hostname = %APPEND%, api.revenuecat.com, api.rc-backup.com
